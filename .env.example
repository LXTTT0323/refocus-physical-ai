# Never commit real credentials. Copy this file to .env locally.
AGENT_STACK_BASE_URL=https://<event-provided-host>
AGENT_STACK_USER_API_KEY=<ag9_uak_placeholder>
AGENT_STACK_PROJECT_ID=<optional_project_id>
AGENT_STACK_AGENT_ID=<optional_agent_id>

# Keep `ocr` for local-only pixels. Set `openai` only after the user accepts
# that individual snapshots leave the device for visual understanding.
REFOCUS_VISUAL_PROVIDER=openai
OPENAI_API_KEY=<optional_openai_api_key>
REFOCUS_OPENAI_VISION_MODEL=gpt-4.1-mini
REFOCUS_OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
