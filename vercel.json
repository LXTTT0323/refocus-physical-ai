{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hkg1"],
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/monitor.mjs": {
      "maxDuration": 180
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/monitor?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), display-capture=(self), microphone=(self)"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
