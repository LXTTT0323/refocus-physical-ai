{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refocus.local/schemas/task-setup-v1.json",
  "title": "RE:FOCUS task setup contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "status",
    "goal",
    "deliverable",
    "success_criteria",
    "focus_minutes",
    "relevance_hints",
    "clarification_question",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill": {
      "const": "task-setup"
    },
    "status": {
      "enum": ["ready", "needs_clarification"]
    },
    "goal": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 240
    },
    "deliverable": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 240
    },
    "success_criteria": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "focus_minutes": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 480
    },
    "relevance_hints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "apps", "domains"],
      "properties": {
        "keywords": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "apps": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "domains": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "clarification_question": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 240
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "goal": {
            "type": "string"
          },
          "deliverable": {
            "type": "string"
          },
          "success_criteria": {
            "minItems": 1
          },
          "clarification_question": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "properties": {
          "clarification_question": {
            "type": "string"
          }
        }
      }
    }
  ]
}
